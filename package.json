{
  "name": "nodebook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Issue-native wiki, planning, reminders, attachments, and MCP workspace on Cloudflare Workers",
  "scripts": {
    "dev:web": "vite",
    "dev:worker": "wrangler dev",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply nodebook --local",
    "db:migrate:remote": "wrangler d1 migrations apply nodebook --remote",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.2.3",
    "hono": "^4.6.14",
    "lucide-react": "^1.31.0",
    "marked": "^12.0.2",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.36",
    "@cloudflare/workers-types": "^5.20260812.1",
    "@playwright/test": "^1.49.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.18.0",
    "shadcn": "^4.17.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8",
    "wrangler": "^4.121.0"
  },
  "allowScripts": {
    "esbuild@0.17.19": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "workerd@1.20241230.0": true,
    "workerd@1.20250718.0": true,
    "workerd@1.20260804.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true,
    "sharp@0.33.5": true
  }
}
