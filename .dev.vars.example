# Copy to .dev.vars for local development (wrangler dev).
# In production, configure these through the Cloudflare dashboard / `wrangler secret put`
# and DO NOT set AUTH_DEV_EMAIL.

# Identity that local development requests are attributed to.
AUTH_DEV_EMAIL=owner@nodebook.local

# Cloudflare Access configuration (leave empty for local development).
# ACCESS_TEAM=example.cloudflareaccess.com
# ACCESS_AUD=<your-access-application-audience-tag>

# The single owner of the workspace. Access assertions are checked against this address.
# OWNER_EMAIL=you@example.com
# OWNER_DISPLAY_NAME=Your Name
# OWNER_TIMEZONE=America/Los_Angeles

# Public HTTPS origin of the OAuth authorization server (production only, e.g.
# https://nodebook.example.com). Leave unset for local development, where the
# request origin is used instead. Must be the stable custom domain, never workers.dev.
# OAUTH_ISSUER=https://nodebook.example.com

# Initial calendar view: day, week, or month (missing/invalid values fall back to week).
# CALENDAR_DEFAULT_VIEW=week

# First day of the calendar week: sunday, monday, …, saturday (missing/invalid values fall back to sunday).
# WEEK_START_DAY=sunday

# Initial number of rows on the Issues page: 20, 50, or 100 (missing/invalid values fall back to 20).
# ISSUES_DEFAULT_LIMIT=20

# Required before saving AI provider connections. Generate once and keep stable:
#   openssl rand -base64 32
# Never commit the generated value or provider API keys.
# CHAT_CREDENTIAL_KEY=<base64-encoded-32-byte-key>
